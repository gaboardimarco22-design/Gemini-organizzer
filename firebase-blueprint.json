{
  "entities": {
    "Folder": {
      "title": "Folder",
      "description": "A user-owned folder for organizing Gemini chat conversations.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "name": {
          "type": "string",
          "description": "Display name of the folder (1-50 chars)."
        },
        "description": {
          "type": "string",
          "description": "Topic description used by Gemini for smart categorization (0-200 chars)."
        },
        "colorKey": {
          "type": "string",
          "enum": ["cobalt", "amber", "emerald", "violet", "coral", "teal"],
          "description": "Semantic color token key for the folder badge."
        },
        "iconKey": {
          "type": "string",
          "enum": ["folder", "code", "work", "school", "lightbulb", "travel", "health", "star"],
          "description": "Icon identifier for the folder."
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether the folder is pinned to the top."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "name", "description", "colorKey", "iconKey", "isPinned", "createdAt", "updatedAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A Gemini conversation thread organized optionally inside a folder.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "description": "Title of the chat conversation (1-120 chars)."
        },
        "folderId": {
          "type": "string",
          "description": "Assigned Folder document ID, or empty string if uncategorized."
        },
        "lastMessagePreview": {
          "type": "string",
          "description": "Short preview of the latest message (0-240 chars)."
        },
        "autoOrganized": {
          "type": "boolean",
          "description": "Whether Gemini automatically organized or titled this chat."
        },
        "summaryTag": {
          "type": "string",
          "description": "Short topic tag generated by Gemini (0-40 chars)."
        },
        "messageCount": {
          "type": "integer",
          "description": "Number of persisted messages in the chat."
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether the chat is pinned."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "title", "folderId", "lastMessagePreview", "autoOrganized", "summaryTag", "messageCount", "isPinned", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "An individual user or Gemini model turn within a chat.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "chatId": {
          "type": "string",
          "description": "Parent Chat document ID."
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"],
          "description": "Author role of the message."
        },
        "text": {
          "type": "string",
          "description": "Message text content (1-32000 chars)."
        },
        "sequence": {
          "type": "integer",
          "description": "Monotonic ordering sequence number."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "chatId", "role", "text", "sequence", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/folders/{folderId}": {
      "schema": {
        "$ref": "#/entities/Folder"
      },
      "description": "User-scoped folders for organizing Gemini chats."
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": {
        "$ref": "#/entities/Chat"
      },
      "description": "User-scoped Gemini chat sessions."
    },
    "/users/{userId}/chats/{chatId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Messages belonging to a user-scoped Gemini chat."
    }
  }
}
